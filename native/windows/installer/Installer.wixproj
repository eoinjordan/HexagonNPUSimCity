<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>HexagonNPUSimCity-arm64</OutputName>
    <InstallerPlatform>arm64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\publish\</PublishDir>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>
</Project>